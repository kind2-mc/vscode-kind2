(*
   CS:5810 Formal Methods in Software Engineering 

   Lustre Practice

*)

(* The current value of isEven(n) is true iff 
   the current value of n is even
*)
node isEven (n: int) returns (b: bool);
let
  b = (n mod 2 = 0);
  
  -- %MAIN;
tel

(* The current value of Sum(x) is the sum of all values of x up to now
*)
node Sum (x: int) returns (s: int);
let
   s =  x -> x + pre s;
tel
(*
        0   1   2   3   4   5 ...
   ------------------------------- 
   x =  5,  3, -1,  2,  7,  8, ...
   s =  5,  8,  7,  9, 16, 24, ...
*)


(* The current value of onlyEven(n) is n 
   if n is even and is 0 otherwise
*)
node onlyEven (x: int) returns (y: int);
let
  y =  if isEven(x) then x else 0;
tel


(* EvensFrom(x) contains, in increasing order, 
   all even numbers greater than the first value of x
*)
node EvensFrom (x: int) returns (e: int);
let
  e = (if isEven(x) then x + 2 else x + 1) -> 2 + pre e;
tel


-- s(_) = 1,2,3,3,3,3,...
-- note: input is irrelevant
node s (_: bool) returns (x: int);
let
  x = 1 -> if pre x < 3 then pre x + 1 else 3;
tel

-- more compact version of s
node s1 (_: bool) returns (x:  int);
let
  x = 1 -> pre (2 -> 3);

  -- check that x is the same stream as s(_);
  check x = s(_);
tel
-- (2 -> 3)     =   2, 3, 3, 3, ...
-- pre (2 -> 3) =  //, 2, 3, 3, ...
-- x            =   1, 2, 3, 3, ...


(* For any boolean stream b,
   fact(b) is the stream containing all the factorial numbers
  in increasing order. 
*)
node fact (_: bool) returns (f: int);
var n: int;
let
  n = 0 -> pre n + 1;
  f = 1 -> n * pre f;
tel


(* Alternate(x) starts at x_0, the initial value of x, and
   keeps alternating between the current value of x and x_0
*)
node Alternate (x: int) returns (y: int);
var x_0: int;
    b: bool;
let
  x_0 = x -> pre x_0;
  b = true -> not pre b;
  y = if b then x_0 else x;

  -- check that when b is true, y is the first value of x
  check b => y = x_0;
  -- check that when b is false y is the current value of x
  check not b => y = x;
tel


(* Timer(reset, pause) starts at 0, and keeps increasing by 1 
   until reset or pause is true. In the first case it goes back to 0.
   In the second one, it stays the same (as long as pause is true)
*)
node Timer( reset, pause : bool ) returns ( c : int );
let
  c = 0 -> if reset then 0
           else if pause then pre c
           else pre c + 1;
tel


node Mystery(_:bool) returns ( A : int );
let
  A = Timer(true -> pre A = 2, false);
tel


(* First(x) is a constant stream whose value is the first value of x.
*)
node First (x: int) returns (fx: int);
let
  fx = x -> pre fx;
tel


(* Counter(x, reset) starts at x and keeps increasing by 1 
   until reset is true, in which case it restarts with the 
   initial value of x
*)
node Counter (x: int; reset: bool) returns (c: int);
let
  c = x -> if reset then First(x) else pre c + 1;
tel

(* Counter is equivalent to the following expanded node *)
node CounterEx (x: int; reset: bool) returns (c: int);
  var fx: int;
let
  fx = x -> pre fx;
  c = x -> if reset then fx else pre c + 1;
tel


node CounterAlt (x: int; reset: bool) returns (c: int);
let
  c = if reset then First(x) else x -> pre c + 1;
tel

(* This _observer_ node thats the same input as Counter
   and feeds it to Counter, CounterEx, and CounterAlt
   checking that their generate the same output
   from the same input.
*)
node CounterObs (x: int; reset: bool) returns (p1, p2: bool);
let
  -- p1 is true iff Counter and CounterEx produce 
  -- the same output from the same input
  p1 = Counter(x, reset) = CounterEx(x, reset) ;
  p2 = Counter(x, reset) = CounterAlt(x, reset) ;

  -- asks Kind 2 to check that p1 and p2 are true at all times
  check p1;
  check p2;

  -- %MAIN;
tel



(* Boolean Switch

   Model a switch with two buttons, Set and Reset.
   Pressing Set turns the switch on.
   Pressing Reset turns the switch off
   If Set and Reset are initially both unpressed,
   the initial position of the switch is determined by
   a third signal, Init
*)
node Switch( Set, Reset, Init : bool ) returns ( S : bool );
let
    S = if Set then true 
        else if Reset then false
        else (Init -> pre S);
tel

node Switch2( Set, Reset, Init : bool ) returns ( S : bool );
let
  S = if Reset then false 
      else if Set then true 
      else (Init -> pre S);
tel

node Switch3( Set, Reset, Init : bool ) returns ( S : bool );
let
  S = Set or (not Reset and (Init -> pre S));
tel


(* The following observer expresses 3 safety requirements
   for the first switch.
*)
node ReqSwitch( Set, Reset, Init : bool )
returns ( R1, R2, R3 : bool );
var S : bool;
let
  S = Switch( Set, Reset, Init );

  -- setting turns the switch on
  R1  =  Set => S;
 
  -- resetting turns the switch off
  R2 =  Reset => not S;
  
  -- doing nothing maintains the previous value
  R3 = true -> (not Set and not Reset) => S = pre S;

  check R1;
  check R2; -- does this hold?
  check R3;

  -- %MAIN;
tel


(* Sofar(b) is true at any point iff x has been true 
   from the beginning until that point
   [It is the same as (Historically b) in Alloy] 
*)
node Sofar( X : bool ) returns ( Y : bool );
let
  Y = X -> (X and pre Y);
tel


(* We would like to prove that:

   R1: "If Set and Reset are never true at the same time,
        then Switch and Switch2 behave in the same way"
  
   R2: "Switch and Switch3 behave in the same way at all times"
*)
node ReqSwitches( Set, Reset, Init : bool ) returns ( R1, R2 : bool );
var x, x2, x3: bool;
let
  x  = Switch ( Set, Reset, Init );
  x2 = Switch2( Set, Reset, Init );
  x3 = Switch3( Set, Reset, Init );

  R1 = Sofar(not (Set and Reset)) => (x = x2);
  R2 = x = x3;

  check R1;
  check R2;

-- %MAIN;
tel

(* Since(b1,b2) is true precisely when b1 has been true
   at some point, and b2 has been continuously true 
   afterwards
*)
node Since( X, Y : bool ) returns ( S : bool );
let
  S =  X or (Y and (false -> pre S));
tel


(* Now we would like to prove that:
 
   R1 - "if the switch is on, 
         it stays so until the next reset"

   R2 - "if the switch is off, it stays so until the next set"

  Equivalently:

   R1 - "if we did not reset since the last time we set, 
         x is true"
   R2 - "if we did not set since the last time we reset,
         x is false"
*)
node ReqSwitchSetIgnoresReset( Set, Reset, Init : bool )
returns ( R1, R2 : bool );
  var b : bool;
let
  b = Switch( Set, Reset, Init );

  R1 = Since( Set, not Reset ) => b;
  R2 = Since( Reset and not Set, not Set ) => not b;

  check R1;
  check R2;
  
  -- %MAIN;
tel


(* An integer switch

   Model an integer switch with a button and an 
   integer input N.
   When the button is pressed the switch takes the value of N
   and maintains it until the next time the button is pressed
   again.
   Before the button is pressed for the first time, the value of
   N is 0.
*)
node SwitchInt( Set : bool; N : int ) returns ( S : int );
let
  S = if Set then N else (0 -> pre S);
tel

(*  Prove that:
    "the SwitchInt node ignores its integer input
     when Set is false"
*)
node SwitchIgnoresx( Set : bool; N1, N2: int )
returns ( OK : bool );
  var Env : bool;
let
  Env =  not Set;
--   Env = Sofar(set => x1 = x2);
  OK  =  Env => SwitchInt(Set, N1) = SwitchInt(Set, N2);

-- %MAIN;   
tel

(* Prove that:
   "Y always has the latest set value of x"

  Let us first do a simple version of this:
   "If we have not set the switch again since the last time 
    the switch was set to 3, then Y must be 3"
*)
node ReqSwitchInt_Simple( Set : bool; X : int ) returns ( OK : bool );
  var Y : int;
let
  Y = SwitchInt( Set, X );

  OK = Since(Set and X = 3, not Set) => Y = 3;

  check OK;
-- %MAIN;
tel

(* Prove that:
   "Y always has the latest set value of x"

    Equivalently, 
  
    "For all values a, 
     if we have not set the switch again since the last time 
     the switch was set to a, then Y must be a"
*)
node ReqSwitchInt( Set : bool; X : int; A : int )
returns ( OK : bool );
  var Y, A_0 : int;
let
  A_0 = First( A );
  Y = SwitchInt( Set, X );

  OK = Since( Set and X = A_0, not Set ) => Y = A_0;

-- %MAIN;
tel

(* Once(b) is true precisely when b has been true 
   at least once since the first instant
*)
node Once(X : bool) returns (Y : bool);
let
  Y = X or (false -> pre Y);
tel


(* Write an observer that checks the following 
   for an integer input stream Y: 

   Whenever Y has the positive value n, 
   its opposite -n has occurred in Y before

*)
node NegBefore(Y: int; const n: int) returns (OK : bool);
let
  OK =  (Y = n and n > 0) => Once(Y = -n);
tel
