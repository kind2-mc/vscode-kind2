-- switch(On,Off) is initially false and
-- raises (false to true) if On is true, and
-- falls (true to false) if Off is true

node switch (On, Off: bool) returns (S: bool);
let
  -- very verbose definition
  -- S = false -> if On = true then true else if Off = true then false else pre S;

  -- less verbose definition
  -- S = false -> if (pre S) = false then On else not Off;

  -- better definition
  S = false -> if (pre S) then not Off else On;
tel