(* Problem derived from the example described at
   https://github.com/ge-high-assurance/VERDICT/wiki/Appendix-A--AADL-Modeling-Tutorial

   See the link for a description.
*)


type SwitchPos = enum { Cool, Off, Heat };

-- All temperatures in degrees Centigrades 
const MinT : real = -20.0; -- minimum temperature
const MaxT : real = 45.0;  -- maximum temperature
const IniT : real = 24.0;  -- initial thermostat temperature
const DB : real = 2.0;     -- dead band
const Diff : real = 1.0;   -- temperature differential

node Since (X : bool; Y : bool) returns (Z : bool);
let
  Z = ((X) or (((Y) and (((false) -> ((pre (Z))))))));
tel

-------------------------
-- SetDesiredTemperature
-------------------------

-- Specification
contract SetDesiredTemperatureCon (up : bool; down : bool) returns (dt : real);
let
  var pre_dt : real = IniT -> pre dt;
  var increment : bool = up and pre_dt + Diff <= MaxT ;
  var decrement : bool = down and pre_dt - Diff >= MinT ;

  assume not (up and down);

  guarantee "Setpoint increment" increment => dt = pre_dt + Diff;
  guarantee "Setpoint decrement" decrement => dt = pre_dt - Diff;
  guarantee "Setpoint invariance" not (increment or decrement) => dt = pre_dt;
tel

node SetDesiredTemperature (up : bool; down : bool)
returns (dt : real);
(*@contract import SetDesiredTemperatureCon(up, down) returns (dt) ; *)
  var pre_dt, offset : real;
let
  pre_dt = IniT -> pre dt;
  offset = if up and pre_dt - MaxT <= -Diff then Diff 
           else if down and pre_dt - MinT >= Diff then -Diff
           else 0.0;
  dt = pre_dt + offset;
tel

----------------------
-- ControlTemperature
----------------------

-- Specification
contract ControlTemperatureCon (switch : SwitchPos; curr_temp : real; set_temp : real)
returns (cool_on : bool; heat_on : bool);
let
  var cooling_start : bool = switch = Cool and curr_temp > set_temp + DB;
  var heating_start : bool = switch = Heat and curr_temp < set_temp - DB;

  mode cooling (
    require cooling_start -> (cooling_start or pre cool_on and switch = Cool and curr_temp > set_temp);
    ensure cool_on;
    ensure not heat_on;
  ) ;

  mode heating (
    require heating_start -> (heating_start or pre heat_on and switch = Heat and curr_temp < set_temp);
    ensure not cool_on;
    ensure heat_on;
  ) ;

  mode off (
    require not ::cooling and not ::heating;
    ensure not cool_on and not heat_on;
  ) ;

tel

-- This node is "imported", it does not have a definition, only a contract.
-- This is useful to model and reason about external components.
node imported ControlTemperature (switch : SwitchPos; curr_temp : real; set_temp : real)
returns (cool_on : bool; heat_on : bool);
(*@contract import ControlTemperatureCon (switch, curr_temp, set_temp)  
                   returns (cool_on, heat_on);
*)


------------------------
-- ThermostatController
------------------------

-- Specification
contract ThermostatControllerCon (switch : SwitchPos; up : bool; down : bool; curr_temp : real)
returns (cool_on : bool; heat_on : bool; set_temp : real);
let
  var curr_temp_in_deadzone : bool =  set_temp - DB <= curr_temp  and  curr_temp <= set_temp + DB;
  var system_is_off : bool = 
    not cool_on and not heat_on;

  assume not (up and down);
  
  guarantee "R1" -- Initial temperature is in range
    MinT <= IniT and IniT <= MaxT;
  guarantee "R2" -- Deadband and Diff are positive values
    DB > 0.0 and Diff > 0.0;
  guarantee "R3" -- No activation signal is enabled if switch is in Off position
    (switch = Off) => (not cool_on and not heat_on);
  guarantee "R4" -- Cooling system is turned on only if switch is in Cool position
    cool_on => switch = Cool;
  guarantee "R5" -- Heating system is turned on only if switch is in Heat position
    heat_on => switch = Heat;
  guarantee "R6" -- Activation signals are never enabled at the same time
    not (cool_on and heat_on);
  guarantee "R7" -- Set temperature is always in range
    MinT <= set_temp and set_temp <= MaxT;
  guarantee "R8" -- Set temperature doesn't change if no button is pressed
    (not up and not down) => set_temp = (IniT -> pre set_temp);
  guarantee "R9" -- Set temperature doesn't decrease if the up button is pressed 
    up => not (set_temp < (IniT -> pre set_temp));
  guarantee "R10" -- Set temperature doesn't increase if the down button is pressed
    down => not (set_temp > (IniT -> pre set_temp));
  guarantee "R11" -- System is off if current temperature is in the dead zone and system was off in the previous step"
    true -> curr_temp_in_deadzone and pre system_is_off => system_is_off;
  guarantee "R12" -- Cooling system is on only if current temperature is higher than the desired temperature" 
    cool_on => curr_temp > set_temp;
  guarantee "R13" -- Heating system is on only if current temperature is lower than the desired temperature"
    heat_on => curr_temp < set_temp;
  guarantee "R14" -- Cooling system is on if switch is in Cool and temperature is higher than the desired temperature plus deadband" 
    switch = Cool and curr_temp > set_temp + DB => cool_on;
  guarantee "R15" -- Heating system is on if switch is in Heat and temperature is lower than the desired temperature minus deadband" 
    switch = Heat and curr_temp < set_temp - DB => heat_on;
  guarantee "R16" -- Once cooling system is on, it remains on while the desired temperature hasn't been reached and switch is on Cool"
    Since(cool_on, switch = Cool and curr_temp > set_temp) => cool_on;
  guarantee "R17" -- Once heating system is On, it remains on while the desired temperature hasn't been reached and switch is on Heat" 
    Since(heat_on, switch = Heat and curr_temp < set_temp) => heat_on;
tel

-- Implementation
node ThermostatController (switch : SwitchPos; up : bool; down : bool; curr_temp : real)
returns (cool_on : bool; heat_on : bool; set_temp : real);
(*@contract import ThermostatControllerCon(switch, up, down, curr_temp) returns (cool_on , heat_on, set_temp) ; *)
let
  set_temp = SetDesiredTemperature(up, down);
  cool_on, heat_on = ControlTemperature(switch, curr_temp, set_temp);
tel


